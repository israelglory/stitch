<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the logo on the app background, until
     Flutter draws the same logo (lib/app/splash.dart) and fades it out.
     Android 12 and later use the splash theme in values-v31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
